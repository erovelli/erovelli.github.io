---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbSchema, projectSchema } from '../../schema';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
/* Entries can carry metadata with no copy written yet, in which case the dek
   and the article are omitted rather than rendered empty. */
const hasBody = Boolean(project.body?.trim());
const {
  title,
  summary,
  status,
  year,
  technologies,
  repository,
  live,
  liveLabel,
  related,
} = project.data;

/* `related` is a list of interest slugs, which Zod cannot check because it
   cannot see a sibling collection. A typo would otherwise ship as a dead link
   that check-build.mjs catches only after a full build, so resolve it here and
   fail the build at the point the mistake was made. */
const interests = await getCollection('interests');
const relatedInterests = related.map((id) => {
  const interest = interests.find((entry) => entry.id === id);
  if (!interest) {
    throw new Error(
      `Project "${project.id}" lists related interest "${id}", which does not exist.`,
    );
  }
  return interest;
});

const trail = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects/' },
];
const schemas = [
  projectSchema(project),
  breadcrumbSchema([
    ...trail,
    { label: title, href: `/projects/${project.id}/` },
  ]),
];
---

<BaseLayout title={title} description={summary} schemas={schemas}>
  <Breadcrumbs trail={trail} current={title} />

  <header class="detail-intro">
    <p class="eyebrow">Project / {status} / {year}</p>
    <h1>{title}</h1>
    {summary && <p class="detail-dek">{summary}</p>}
  </header>

  <div class="detail-layout">
    <article class:list={['detail-main', !hasBody && 'detail-main-bare']}>
      {
        hasBody && (
          <div class="prose">
            <Content />
          </div>
        )
      }

      <nav class="detail-navigation" aria-label="Project navigation">
        <a href="/projects/">← Back to projects</a>
      </nav>
    </article>

    <aside class="detail-rail" aria-label="Project metadata">
      <section aria-labelledby="project-details">
        <h2 id="project-details">Project details</h2>
        <dl class="rail-list">
          <div>
            <dt>Status</dt>
            <dd>{status}</dd>
          </div>
          <div>
            <dt>Year</dt>
            <dd>{year}</dd>
          </div>
          <div>
            <dt>Technology</dt>
            <dd>{technologies.join(' / ')}</dd>
          </div>
        </dl>
      </section>

      {
        relatedInterests.length > 0 && (
          <nav class="rail-links" aria-label="Related interests">
            {relatedInterests.map((interest) => (
              <a href={`/interests/${interest.id}/`}>{interest.data.title} →</a>
            ))}
          </nav>
        )
      }

      {
        (repository || live) && (
          <nav class="rail-links" aria-label="External project links">
            {repository && (
              <a href={repository} target="_blank" rel="noreferrer">
                Source code ↗<span class="sr-only">(opens in a new tab)</span>
              </a>
            )}
            {live && (
              <a href={live} target="_blank" rel="noreferrer">
                {liveLabel} ↗<span class="sr-only">(opens in a new tab)</span>
              </a>
            )}
          </nav>
        )
      }
    </aside>
  </div>
</BaseLayout>
