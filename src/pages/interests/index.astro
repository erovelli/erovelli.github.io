---
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import InterestRow from '../../components/InterestRow.astro';
import Module from '../../components/Module.astro';
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../../schema';

const interests = (await getCollection('interests')).sort(
  (a, b) => a.data.order - b.data.order,
);

const trail = [{ label: 'Home', href: '/' }];
const schemas = [
  breadcrumbSchema([...trail, { label: 'Interests', href: '/interests/' }]),
];
---

<BaseLayout
  title="Interests"
  description="The ideas and practices Evan Rovelli keeps coming back to: local-first software, systems design, Rust, data visualization, and hardware."
  schemas={schemas}
>
  <Breadcrumbs trail={trail} current="Interests" />

  <PageIntro
    eyebrow="Notes"
    title="Interests"
    lead="Ideas I keep coming back to, and why. Shorter and less finished than the project write-ups."
  />

  <Module title="Interest index" id="interest-index" class="page-index">
    <div class="index-list">
      {
        interests.map((interest) => (
          <InterestRow interest={interest} headingLevel={3} />
        ))
      }
    </div>
  </Module>
</BaseLayout>
