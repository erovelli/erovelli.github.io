---
import type { CollectionEntry } from 'astro:content';

interface Props {
  interest: CollectionEntry<'interests'>;
  headingLevel?: 2 | 3;
}

const { interest, headingLevel = 2 } = Astro.props;
const { title, summary, topics } = interest.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const href = `/interests/${interest.id}/`;
---

<article
  class:list={['index-row', 'interest-row', !summary && 'index-row-bare']}
>
  <div class="row-primary">
    <p class="row-kicker">{topics.join(' / ')}</p>
    <Heading class="row-title"><a href={href}>{title}</a></Heading>
  </div>

  {summary && <p class="row-summary">{summary}</p>}
  <span class="row-arrow" aria-hidden="true">→</span>
</article>
