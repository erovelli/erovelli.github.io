---
import { navigation, site } from '../config';
import ThemeControl from './ThemeControl.astro';

const pathname = Astro.url.pathname;

/**
 * A section is current when the URL is that page or sits beneath it, so
 * /projects/tidyup/ still marks Projects. Home is matched exactly, since every
 * path starts with "/".
 */
const isCurrent = (href: string) =>
  href === '/' ? pathname === href : pathname.startsWith(href);
---

<header class="site-header">
  {
    /* The monogram repeats the domain beside it, so it is decorative: leaving
      it in the accessibility tree makes the home link read "E R erovel dot
      li". The domain alone is the accessible name. */
  }
  <a class="wordmark" href="/">
    <span class="wordmark-monogram" aria-hidden="true">{site.initials}</span>
    <span class="wordmark-domain">{site.domain}</span>
  </a>

  <div class="header-tools">
    <nav class="site-nav" aria-label="Primary">
      {
        navigation.map((item, index) => (
          <>
            <a
              class="nav-link"
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
            {index < navigation.length - 1 && (
              <span class="nav-separator" aria-hidden="true">
                /
              </span>
            )}
          </>
        ))
      }
    </nav>
    <ThemeControl />
  </div>
</header>
