---
import { site } from '../config';
import BrandIcon from './BrandIcon.astro';
import PixelIcon from './PixelIcon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="footer-identity">
    <PixelIcon name="smile" />
    <span>© {year} {site.name}</span>
  </p>
  <a class="footer-email" href={site.mailto}>
    <PixelIcon name="mail" />
    <span>{site.email}</span>
  </a>

  {
    /* The handle, not just the platform name. "GitHub" alone says where the
      profile is; "GitHub @erovelli" says who it belongs to, which is the thing
      a reader recognizes and the thing a search engine can match. */
  }
  <nav class="footer-nav" aria-label="Contact and social">
    {
      site.socials.map((social) => (
        <a
          href={social.href}
          rel={social.me ? 'me noreferrer' : 'noreferrer'}
          target="_blank"
        >
          <BrandIcon name={social.icon} />
          {social.label} {social.handle}
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      ))
    }
  </nav>
</footer>
