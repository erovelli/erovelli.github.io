---
import { pixelIconSource, type PixelIconName } from '../icons';

interface Row {
  label: string;
  value: string;
  icon: PixelIconName;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---

{
  /* Each row's icon is drawn by `.metadata-row::before`, not a child element:
    inside a <dl>, a <div> wrapper may contain only <dt> and <dd>. */
}
<dl class="metadata-rows">
  {
    rows.map((row) => (
      <div class="metadata-row" style={pixelIconSource(row.icon)}>
        <dt>{row.label}</dt>
        <dd>{row.value}</dd>
      </div>
    ))
  }
</dl>
