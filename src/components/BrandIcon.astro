---
import { brandIcons, type BrandIconName } from '../icons';

interface Props {
  name: BrandIconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const source = brandIcons[name];
---

<span
  class:list={['brand-icon', className]}
  style={`--brand-icon-source: url("${source}")`}
  aria-hidden="true"></span>
